{
  "name": "blueberry",
  "version": "0.0.1",
  "description": "Discord Bot with a bunch of utilities, I think.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node --env-file=.env index.js",
    "dev": "node --env-file=.env --trace-warnings index.js",
    "deploy": "node --env-file=.env cmd/deploy.js",
    "deploy-guild": "node --env-file=.env cmd/deploy-guild.js",
    "lint": "eslint ./*",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:i18n": "pnpm paraglide-js compile --project ./project.inlang --outdir ./paraglide"
  },
  "keywords": [
    "bot",
    "discord",
    "utilities"
  ],
  "author": "gaxolotl",
  "license": "MPL-2.0",
  "packageManager": "pnpm@11.10.0",
  "dependencies": {
    "@inlang/paraglide-js": "^2.22.0",
    "@resvg/resvg-js": "^2.6.2",
    "chalk": "^5.6.2",
    "discord.js": "^14.26.4",
    "image-size": "^2.0.2",
    "mongoose": "^9.7.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inlang/cli": "^3.1.15",
    "eslint": "^10.6.0"
  }
}
